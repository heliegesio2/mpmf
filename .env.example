# PostgreSQL
DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/mercadinho

# Assinatura da sessao de login. Troque por outro valor aleatorio.
# Gere o seu com:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=ff1b5a4d5b5f67784a7ac86130710cb1fdffaafdd5fa44eecf65fcc59ef72576

# Pix: fallback so. O normal e cada empresa cadastrar a chave em /configuracoes;
# estas variaveis so valem quando a empresa nao tem chave propria.
PIX_CHAVE=
PIX_NOME=
PIX_CIDADE=SAO PAULO

# Anthropic (leitura de cupom fiscal em Importar compra). Crie a sua em
# https://console.anthropic.com
ANTHROPIC_API_KEY=
# Opcional: troca o modelo usado na leitura do cupom (padrao: claude-opus-5)
ANTHROPIC_MODEL=

# Login social (opcional). Sem estas variaveis os botoes aparecem mas avisam
# que nao esta configurado. Crie os apps no Google Cloud Console e no Facebook
# for Developers e registre o redirect:
#   ${APP_URL}/api/auth/oauth/google/callback
#   ${APP_URL}/api/auth/oauth/facebook/callback
APP_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
